# Server-only. Copy to .env.local for development or an external systemd
# EnvironmentFile in production. Never commit real credentials.
DATABASE_URL=postgresql://kiraquest:replace-me@127.0.0.1:5432/kiraquest
# Explicit opt-in. Keep disabled on public HTTP and until recovery and HTTPS are ready.
KIRAQUEST_PASSWORD_AUTH=disabled
BETTER_AUTH_URL=https://learn.example.com
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-web-client-secret
# Optional separate server secret for PIN hashes. Keep it stable; rotating it
# requires users to recover their device PIN through Google.
KIRAQUEST_PIN_PEPPER=replace-with-an-independent-random-secret-at-least-32-characters
# For local development only: prints codes in the development server terminal.
# Never enable this mode on production or shared machines.
KIRAQUEST_MAIL_MODE=development
# For real delivery use KIRAQUEST_MAIL_MODE=resend and set these on the server:
# RESEND_API_KEY=replace-me
# KIRAQUEST_MAIL_FROM=KiraQuest <auth@example.com>
# For a SendGrid test use KIRAQUEST_MAIL_MODE=sendgrid, and set on the server:
# SENDGRID_API_KEY=replace-me
# KIRAQUEST_MAIL_FROM=verified-sender@example.com
